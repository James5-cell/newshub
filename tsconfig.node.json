{
  "extends": [
    "./tsconfig.base.json"
  ],
  "compilerOptions": {
    "lib": [
      "ES2020"
    ],
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "#nitro/index": [
        "server/nitro-index.d.ts"
      ],
      "#/*": [
        "server/*"
      ],
      "@shared/*": [
        "shared/*"
      ]
    },
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "server",
    "*.config.*",
    "shared",
    "test",
    "scripts",
    "tools",
    "dist/.nitro/types",
    "src/mascot/engine.ts",
    "src/mascot.config.ts"
  ]
}
