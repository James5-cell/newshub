            <div className="text-[10px] op-40 max-w-[200px] truncate">
              標籤: {(() => {
                try { return JSON.parse(source.tags).join(', ') } catch { return source.tags }
              })()}
            </div>
          )}
        </div>
      </div>

      {/* Actions */}
      <div className="flex items-center gap-2 flex-shrink-0">
